# 1. Supabase Client Configuration (Public / Safe for Browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Server-Side Secret Key (NEVER expose to frontend browser code)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Razorpay Payment Gateway Configuration
# Key ID is safe for browser initialization; Key Secret & Webhook Secret MUST remain server-side
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key_server_only
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_server_only

# 4. Local Server Configuration
PORT=3001
VITE_API_BASE_URL=/api
